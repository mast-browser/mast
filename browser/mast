#!/usr/bin/env bash
# Mast build CLI (Hetzner Cloud). The builder only exists while we're building:
# Hetzner bills servers even when powered off, so "stop" means delete. Between sessions the
# disk can be kept as a compressed snapshot (cheap) or thrown away (rebuild from scratch).
#
#   ./mast up [type]        create the builder (from the last snapshot if there is one)
#   ./mast build            push code → build → download (creates the builder if needed)
#   ./mast unattended       build + shots on the builder, which then snapshots and deletes itself (laptop can be off)
#   ./mast collect          after an unattended build: download the browser, patches and shots, then down --keep
#   ./mast down [--keep]    delete the builder; --keep snapshots its disk first
#   ./mast resize <type>    change server type, keeping the disk
#   ./mast cost             money spent so far vs MAST_BUDGET
#   ./mast hold <minutes>   keep an idle builder alive that long (e.g. while writing code)
#   ./mast run              run the downloaded browser locally
#   ./mast release [--dry-run]  hand the builder's build to GitHub, which packages, signs and publishes it
#   ./mast package          (by hand) turn the download into a signed release (.deb, .rpm, tarball, apt/dnf sources) -> dist/release/
#   ./mast publish          (by hand) put dist/release online (GitHub release + Pages); apt/dnf users then update
#   ./mast shots            screenshot fixed UI scenes on the builder (Xvfb) -> shots/<time>/
#   ./mast check-patches    check every make-patches.py anchor locally, on both bases (no builder, no cost)
#   ./mast check-rebase <v> what moving to Chromium <v> breaks, before building (local, no cost)
#   ./mast status | ssh | logs [job] | destroy
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=mast.env
source "$ROOT/mast.env"
STATE=$ROOT/.state
LEDGER=$STATE/ledger # "<epoch> <event> <type> <usd_per_hour>"
mkdir -p "$STATE"
HOST=""

die() { echo "mast: $*" >&2; exit 1; }
log() { printf '\033[1;33m›\033[0m %s\n' "$*"; }
need() { command -v "$1" >/dev/null || die "$1 not found. Run inside: nix develop"; }

SSH_OPTS=(-i "$MAST_KEY" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$STATE/known_hosts"
	-o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o ConnectTimeout=15 -o ConnectionAttempts=4 -o LogLevel=ERROR)

exists() { hcloud server describe "$MAST_NAME" >/dev/null 2>&1; }
server_ip() { hcloud server ip "$MAST_NAME"; }
server_type() { hcloud server describe "$MAST_NAME" -o format='{{.ServerType.Name}}'; }
hourly() { hcloud server-type describe "$1" -o json | jq -r --arg l "$MAST_LOCATION" '.prices[] | select(.location==$l) | .price_hourly.net'; }
latest_snapshot() {
	hcloud image list --type snapshot --selector mast=builder -o json |
		jq -r 'sort_by(.created) | last | .id // empty'
}
rssh() { ssh "${SSH_OPTS[@]}" "root@$HOST" "$@"; }

# ---------------------------------------------------------------- money

ledger() { echo "$(date +%s) $*" >> "$LEDGER"; }

# Server-hours (with the price at the time) plus snapshot storage, in USD.
spent() {
	[[ -f $LEDGER ]] || { echo 0; return; }
	awk -v now="$(date +%s)" -v snap_rate="$MAST_SNAPSHOT_USD_GB_MONTH" '
		$2 == "up" || $2 == "resize" { if (on) total += (($1 - t0) / 3600) * rate; on = 1; t0 = $1; rate = $4 }
		$2 == "down" { if (on) total += (($1 - t0) / 3600) * rate; on = 0 }
		$2 == "extra" { total += $4 }
		$2 == "snap" { snaps[$3] = $1; gb[$3] = $4 }
		$2 == "unsnap" { if ($3 in snaps) { total += (($1 - snaps[$3]) / 2592000) * gb[$3] * snap_rate; delete snaps[$3] } }
		END {
			if (on) total += ((now - t0) / 3600) * rate
			for (s in snaps) total += ((now - snaps[s]) / 2592000) * gb[s] * snap_rate
			printf "%.2f\n", total
		}' "$LEDGER"
}

cmd_cost() {
	local s
	s=$(spent)
	printf 'spent:  $%s of $%s budget\n' "$s" "$MAST_BUDGET"
	if exists; then printf 'now:    %s running at $%s/hour\n' "$(server_type)" "$(hourly "$(server_type)")"; fi
}

# ---------------------------------------------------------------- lifecycle

ensure_key_and_firewall() {
	if [[ ! -f $MAST_KEY ]]; then
		log "creating ssh key $MAST_KEY"
		ssh-keygen -q -t ed25519 -N "" -C "$MAST_NAME" -f "$MAST_KEY"
	fi
	hcloud ssh-key describe "$MAST_NAME" >/dev/null 2>&1 ||
		hcloud ssh-key create --name "$MAST_NAME" --public-key-from-file "$MAST_KEY.pub" >/dev/null
	hcloud firewall describe "$MAST_NAME" >/dev/null 2>&1 || hcloud firewall create --name "$MAST_NAME" >/dev/null
	# SSH only from your current public IP (home IPs change, so this is redone every time).
	local ip rules
	ip="$(curl -fsS https://checkip.amazonaws.com | tr -d '[:space:]')/32"
	rules=$(jq -nc --arg ip "$ip" '[{direction:"in",protocol:"tcp",port:"22",source_ips:[$ip],description:"ssh"}]')
	hcloud firewall replace-rules "$MAST_NAME" --rules-file <(echo "$rules") >/dev/null
}

wait_ssh() {
	HOST=$(server_ip)
	log "waiting for ssh on $HOST"
	ssh-keygen -R "$HOST" -f "$STATE/known_hosts" >/dev/null 2>&1 || true
	for _ in $(seq 60); do
		rssh true 2>/dev/null && return
		sleep 5
	done
	die "ssh to $HOST timed out"
}

check_budget() {
	local s
	s=$(spent)
	awk -v s="$s" -v b="$MAST_BUDGET" 'BEGIN { exit !(s >= b * 0.9) }' &&
		die "spent \$$s of the \$$MAST_BUDGET budget. Raise MAST_BUDGET in mast.env to continue."
	return 0
}

cmd_up() {
	need hcloud
	settle
	# The firewall follows your current IP even for a running builder (home IPs change).
	exists && { ensure_key_and_firewall; HOST=$(server_ip); log "builder already running ($(server_type), $HOST)"; return; }
	check_budget
	ensure_key_and_firewall
	local type=${1:-$MAST_TYPE} image snap
	snap=$(latest_snapshot)
	image=${snap:-ubuntu-24.04}
	log "creating $type in $MAST_LOCATION from ${snap:+snapshot }$image at \$$(hourly "$type")/hour"
	hcloud server create --name "$MAST_NAME" --type "$type" --image "$image" --location "$MAST_LOCATION" \
		--ssh-key "$MAST_NAME" --firewall "$MAST_NAME" --label mast=builder >/dev/null
	ledger up "$type" "$(hourly "$type")"
	wait_ssh
	start_guard
	if [[ -z $snap ]]; then
		push
		log "fresh server: installing packages and syncing Chromium (about 30–45 min)"
		job bootstrap || die "bootstrap failed. Inspect with: ./mast ssh"
	fi
}

# An unattended builder deletes itself while the laptop may be off: close its ledger entry at
# the time of the snapshot it left (within minutes of the delete), so cost stays honest.
settle() {
	awk '$2 == "up" || $2 == "resize" { on = 1 } $2 == "down" { on = 0 } END { exit !on }' "$LEDGER" 2>/dev/null || return 0
	exists && return 0
	local id t gb
	id=$(latest_snapshot)
	if [[ -n $id ]]; then
		t=$(date -d "$(hcloud image describe "$id" -o json | jq -r .created)" +%s)
		gb=$(hcloud image describe "$id" -o json | jq -r '.image_size // .disk_size')
		if ! grep -q " snap $id " "$LEDGER"; then
			echo "$t snap $id $gb" >> "$LEDGER"
			# The snapshot takes a few minutes; count ten more of server time to be safe.
			echo "$((t + 600)) down" >> "$LEDGER"
			log "settled the unattended run: builder gone, snapshot $id (${gb} GB)"
			return 0
		fi
	fi
	ledger down
	log "builder is gone; closed its ledger entry now"
}

cmd_down() {
	exists || { log "no builder running"; return; }
	if [[ ${1:-} == --keep ]]; then
		log "snapshotting the disk (keeps the checkout + build cache)"
		hcloud server shutdown "$MAST_NAME" >/dev/null 2>&1 || true
		local id gb old
		old=$(hcloud image list --type snapshot --selector mast=builder -o json | jq -r '.[].id')
		hcloud server create-image "$MAST_NAME" --type snapshot --description "mast $(date +%F)" \
			--label mast=builder >/dev/null
		id=$(latest_snapshot)
		[[ -n $id ]] || die "snapshot failed; builder kept so nothing is lost"
		gb=$(hcloud image describe "$id" -o json | jq -r '.image_size // .disk_size')
		ledger snap "$id" "$gb"
		for o in $old; do hcloud image delete "$o" >/dev/null && ledger unsnap "$o"; done
		log "snapshot $id saved (${gb} GB, about \$$(awk -v g="$gb" -v r="$MAST_SNAPSHOT_USD_GB_MONTH" 'BEGIN{printf "%.2f", g*r}')/month)"
	fi
	hcloud server delete "$MAST_NAME" >/dev/null
	ledger down
	stop_guard
	log "builder deleted. Spent so far: \$$(spent) of \$$MAST_BUDGET"
}

cmd_resize() {
	local t=${1:?usage: ./mast resize <server-type>}
	exists || die "no builder running"
	log "resizing to $t (disk kept)"
	hcloud server poweroff "$MAST_NAME" >/dev/null
	hcloud server change-type "$MAST_NAME" "$t" --keep-disk >/dev/null
	ledger resize "$t" "$(hourly "$t")"
	hcloud server poweron "$MAST_NAME" >/dev/null
	wait_ssh
}

cmd_hold() {
	local m=${1:?usage: ./mast hold <minutes>}
	echo $(($(date +%s) + m * 60)) > "$STATE/hold"
	local usd
	usd=$(awk -v m="$m" -v r="$(hourly "$(server_type)")" 'BEGIN { printf "%.2f", m / 60 * r }')
	log "guard will keep the builder for $m more minutes (about \$$usd at the current rate)"
}

cmd_status() {
	if exists; then
		printf 'builder: %s  %s  %s\n' "$(server_type)" "$(server_ip)" "$(hcloud server describe "$MAST_NAME" -o format='{{.Status}}')"
	else
		echo "builder: none"
	fi
	local snap
	snap=$(latest_snapshot)
	echo "snapshot: ${snap:-none}"
	cmd_cost
}

cmd_destroy() {
	read -r -p "Delete the builder, all snapshots, firewall and key? Type 'destroy': " ok
	[[ $ok == destroy ]] || die "cancelled"
	if exists; then hcloud server delete "$MAST_NAME" >/dev/null; ledger down; fi
	for o in $(hcloud image list --type snapshot --selector mast=builder -o json | jq -r '.[].id'); do
		hcloud image delete "$o" >/dev/null && ledger unsnap "$o"
	done
	hcloud firewall delete "$MAST_NAME" >/dev/null 2>&1 || true
	hcloud ssh-key delete "$MAST_NAME" >/dev/null 2>&1 || true
	stop_guard
	log "everything deleted. Total spent: \$$(spent)"
}

# ---------------------------------------------------------------- guard
# Runs on this laptop while a builder exists. Deletes the builder if nothing has run on it
# for MAST_IDLE_MINUTES, or if spending reaches the budget. (A token on the server could do
# this itself, but that would put a project-wide credential on the builder.)

start_guard() {
	stop_guard
	setsid nohup "$ROOT/mast" _guard >> "$STATE/guard.log" 2>&1 < /dev/null &
	echo $! > "$STATE/guard.pid"
}

stop_guard() {
	[[ -f $STATE/guard.pid ]] || return 0
	local pid
	pid=$(cat "$STATE/guard.pid")
	[[ $pid != "$$" ]] && kill "$pid" 2>/dev/null || true
	rm -f "$STATE/guard.pid"
}

cmd__guard() {
	local idle_since
	idle_since=$(date +%s)
	while exists; do
		HOST=$(server_ip)
		if awk -v s="$(spent)" -v b="$MAST_BUDGET" 'BEGIN { exit !(s >= b * 0.95) }'; then
			log "$(date) budget nearly spent (\$$(spent)): snapshotting, then deleting builder"
			echo $$ > "$STATE/guard.pid"
			cmd_down --keep
			exit 0
		fi
		if (($(cat "$STATE/hold" 2>/dev/null || echo 0) > $(date +%s))) ||
			# Jobs run as "bash remote/<job>.sh" from ~/mast, so match on remote/<job>.sh.
			rssh "pgrep -f 'remote/(bootstrap|build|ungoogle|shots)\.sh' >/dev/null || [ -n \"\$(who)\" ]" 2>/dev/null; then
			idle_since=$(date +%s)
		elif (($(date +%s) - idle_since > MAST_IDLE_MINUTES * 60)); then
			# Snapshot first: a laptop that slept through the end of a build must not
			# throw away the tree and build cache.
			log "$(date) idle for ${MAST_IDLE_MINUTES}m: snapshotting, then deleting builder"
			echo $$ > "$STATE/guard.pid"
			cmd_down --keep
			exit 0
		fi
		sleep 120
	done
	rm -f "$STATE/guard.pid"
}

# ---------------------------------------------------------------- jobs

push() {
	log "pushing code"
	rsync -az --timeout=120 --delete -e "ssh ${SSH_OPTS[*]}" \
		"$ROOT/remote" "$ROOT/patches" "$ROOT/src" "$ROOT/wallpapers" "$ROOT/fonts" "$ROOT/privacy.json" "$ROOT/chromium_version.txt" "$ROOT/ungoogled_version.txt" \
		"$ROOT/../blocklist" "root@$HOST:mast/"
}

# Run remote/<job>.sh detached on the builder (survives your laptop disconnecting), then follow its log.
job() {
	local name=$1
	# Explicit check: callers use "job build || ...", where bash ignores set -e inside
	# the function, so a failed start used to fall through and replay the old log.
	rssh "cd ~/mast && rm -f $name.status && (nohup bash -c 'bash remote/$name.sh; echo \$? > ~/mast/$name.status' > ~/mast/$name.log 2>&1 &)" ||
		{ echo "mast: couldn't start $name on the builder (ssh failed)" >&2; return 1; }
	follow "$name"
}

follow() {
	local name=$1 rc from=1
	log "following $name log (Ctrl-C detaches; the job keeps running)"
	while true; do
		rssh "tail -n +$from -f ~/mast/$name.log & t=\$!; while [ ! -f ~/mast/$name.status ]; do sleep 3; done; sleep 1; kill \$t; exit \$(cat ~/mast/$name.status)" && return 0
		rc=$?
		# ssh exits 255 when the connection drops; anything else is the job's own status.
		((rc == 255)) || return "$rc"
		log "connection to the builder dropped; reconnecting (the job keeps running)"
		sleep 10
		from=$(rssh "wc -l < ~/mast/$name.log" 2>/dev/null || echo 1)
	done
}

# Serve the builder's dist/ (the build tarball and VERSION) at a secret address through a
# temporary Cloudflare quick tunnel: sets BUILD_URL (<tunnel>/<token>) and BUILD_SUM (the
# tarball's SHA-256). The caller stops it: tunnel_close.
tunnel_open() {
	local token url
	token=$(head -c 18 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 24)
	log "publishing the build through a temporary Cloudflare tunnel (much faster than SSH from Hetzner)"
	rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" "$ROOT/remote/serve.sh" "root@$HOST:mast/remote/"
	url=$(rssh "bash ~/mast/remote/serve.sh $token")
	[[ $url == https://* ]] || die "tunnel failed: $url"
	BUILD_URL=$url/$token
	# A brand-new tunnel hostname takes a little while to appear in DNS; asking too
	# early caches "no such host" for minutes. Wait until it actually answers.
	log "waiting for the tunnel to come online"
	for _ in $(seq 60); do
		curl -fsS -m 10 -o /dev/null "$BUILD_URL/sha256" 2>/dev/null && break
		sleep 5
	done
	BUILD_SUM=$(curl -fsS -m 30 --retry 5 --retry-all-errors "$BUILD_URL/sha256")
}
tunnel_close() { rssh "bash ~/mast/remote/serve.sh stop" >/dev/null 2>&1 || true; }

cmd_fetch() {
	[[ -n $HOST ]] || HOST=$(server_ip)
	local url sum token
	tunnel_open
	trap tunnel_close RETURN
	url=${BUILD_URL%/*} sum=$BUILD_SUM token=${BUILD_URL##*/}
	mkdir -p "$ROOT/dist"
	log "downloading build"
	rm -f "$ROOT/dist/mast-linux.tar.zst"
	# A quick tunnel sometimes stalls for good (build 23 stopped at 2%): then resume over
	# SSH, slower but dependable, instead of failing the build and skipping its shots.
	if ! curl -fL -C - --retry 5 --retry-all-errors --speed-limit 1024 --speed-time 60 --progress-bar \
		-o "$ROOT/dist/mast-linux.tar.zst" "$url/$token/mast-linux.tar.zst" ||
		! curl -fsS --retry 5 -o "$ROOT/dist/VERSION" "$url/$token/VERSION"; then
		log "the tunnel stalled; downloading over SSH instead"
		rsync -a --partial --timeout=120 -e "ssh ${SSH_OPTS[*]}" \
			"root@$HOST:mast/dist/mast-linux.tar.zst" "root@$HOST:mast/dist/VERSION" "$ROOT/dist/" ||
			die "download failed (the builder still has it: ./mast fetch)"
	fi
	echo "$sum  $ROOT/dist/mast-linux.tar.zst" | sha256sum -c --quiet || die "checksum mismatch"
	rm -rf "$ROOT/dist/mast"
	mkdir -p "$ROOT/dist/mast"
	tar --zstd -xf "$ROOT/dist/mast-linux.tar.zst" -C "$ROOT/dist/mast"
	log "browser in dist/mast (Chromium $(cat "$ROOT/dist/VERSION")). Run: ./mast run"
}

# The builder regenerates Mast's patches against the de-Googled base; keep the repo's copy current.
pull_patches() {
	rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" "root@$HOST:mast/patches/*.patch" "$ROOT/patches/" || true
}

# Start a build nobody watches: remote/unattended.sh builds, takes the screenshots, then
# snapshots the builder and deletes it, so it needs the Hetzner token (in memory there, never
# on its disk past the first second). MAST_DEADLINE_HOURS (default 8) caps the whole run.
cmd_unattended() {
	check_budget
	cmd_up
	HOST=$(server_ip)
	push
	local token
	token=${HCLOUD_TOKEN:-$(awk -v c="$(hcloud context active)" '
		/^\[\[contexts\]\]/ { n = "" } /^ *name *=/ { gsub(/["[:space:]]/, ""); sub(/^name=/, ""); n = $0 }
		/^ *token *=/ && n == c { gsub(/["[:space:]]/, ""); sub(/^token=/, ""); print; exit }' ~/.config/hcloud/cli.toml)}
	[[ -n $token ]] || die "no Hetzner token found (hcloud context, or HCLOUD_TOKEN)"
	printf '%s' "$token" | rssh "umask 077; cat > /root/.mast-hcloud-token"
	rssh "cd ~/mast && rm -f build.status shots.status deadline.status && (setsid nohup bash remote/unattended.sh '$MAST_NAME' '${MAST_DEADLINE_HOURS:-8}' > ~/mast/unattended.log 2>&1 < /dev/null &)"
	sleep 5
	rssh "test ! -e /root/.mast-hcloud-token && pgrep -f 'remote/[u]nattended\.sh' >/dev/null" ||
		die "the unattended job didn't start. Inspect with: ./mast ssh  (or ./mast down)"
	# The builder deletes itself; the laptop's idle guard must not race it.
	stop_guard
	log "unattended build running; the builder snapshots and deletes itself (cap ${MAST_DEADLINE_HOURS:-8} h)"
	log "you can shut the laptop down. Later: ./mast collect"
}

# After ./mast unattended: bring the builder back from its snapshot, report how the run went,
# download the browser, the regenerated patches and the screenshots, then snapshot and delete.
cmd_collect() {
	cmd_up
	HOST=$(server_ip)
	rssh "cd ~/mast; tail -5 unattended.log; for s in build shots deadline; do [ -f \$s.status ] && echo \"\$s: \$(cat \$s.status)\"; done; true"
	if [[ $(rssh "cat ~/mast/build.status 2>/dev/null") == 0 ]]; then
		pull_patches
		cmd_fetch
		local dir
		dir="$ROOT/shots/$(date +%m%d-%H%M%S)"
		mkdir -p "$dir"
		rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" --include="*.jpg" --include="*.json" --include="*.txt" --exclude="*" "root@$HOST:mast/shots/" "$dir/" &&
			ln -sfn "$dir" "$ROOT/shots/latest" && log "screenshots in ${dir#"$ROOT/"}"
	else
		rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" "root@$HOST:mast/build.log" "$STATE/unattended-build.log" || true
		log "the build failed; its log is in .state/unattended-build.log (builder still up: fix, then ./mast build, or ./mast down --keep)"
		return 1
	fi
	cmd_down --keep
}

cmd_build() {
	cmd_up
	HOST=$(server_ip)
	push
	job build || { pull_patches; die "build failed. Inspect with: ./mast ssh  (or ./mast down to stop paying)"; }
	pull_patches
	[[ -n ${MAST_SKIP_FETCH:-} ]] || cmd_fetch
	log "builder still running for quick rebuilds. When done: ./mast down [--keep]"
}

# Hand the builder's build to GitHub, which packages, signs and publishes it
# (.github/workflows/release.yml), so nothing large goes through this connection. Waits
# until the release is out, then pulls the CHANGELOG commit GitHub made. Release notes come
# from CHANGELOG.md on GitHub's main. --dry-run signs but doesn't publish.
cmd_release() {
	need gh
	local dry=false
	[[ ${1:-} == --dry-run ]] && dry=true
	[[ -n $HOST ]] || HOST=$(server_ip)
	local repo=$MAST_RELEASES_REPO started run url job conclusion
	gh auth status >/dev/null 2>&1 || die "gh isn't logged in (gh auth login)"
	git -C "$ROOT/.." fetch -q origin main
	[[ -z $(git -C "$ROOT/.." log --oneline origin/main..HEAD) ]] ||
		die "push first: GitHub builds the release notes from its main, which is behind yours"
	git -C "$ROOT/.." show origin/main:CHANGELOG.md | awk '/^## Unreleased/ { on = 1; next } /^## / { on = 0 } on' | grep -q '[^[:space:]]' ||
		die "CHANGELOG.md has nothing under \"## Unreleased\" on main: add what's new first"
	tunnel_open
	trap tunnel_close RETURN EXIT # die exits without returning
	started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	log "starting the release on GitHub"
	gh workflow run release.yml --repo "$repo" --ref main -f build="$BUILD_URL" -f sha256="$BUILD_SUM" -f dry_run=$dry >/dev/null
	for _ in $(seq 30); do
		run=$(gh run list --repo "$repo" --workflow release.yml --event workflow_dispatch --limit 5 \
			--json databaseId,createdAt -q "[.[] | select(.createdAt >= \"$started\")][0].databaseId // empty")
		[[ -n $run ]] && break
		sleep 4
	done
	[[ -n $run ]] || die "the release run didn't appear on GitHub"
	url=https://github.com/$repo/actions/runs/$run
	log "GitHub is downloading the build: $url"
	for _ in $(seq 360); do
		job=$(gh run view "$run" --repo "$repo" --json jobs -q '.jobs[] | select(.name == "Fetch the build") | .status + " " + .conclusion')
		[[ $job == completed* ]] && break
		sleep 10
	done
	conclusion=${job#completed }
	[[ $job == completed* && $conclusion == success ]] || die "GitHub couldn't fetch the build ($job): $url"
	tunnel_close
	log "GitHub has the build; packaging, signing and publishing it"
	# The builder idles meanwhile (a few minutes, about $0.02): the next command takes it down.
	for _ in $(seq 360); do
		[[ $(gh run view "$run" --repo "$repo" --json status -q .status) == completed ]] && break
		sleep 10
	done
	conclusion=$(gh run view "$run" --repo "$repo" --json conclusion -q .conclusion)
	[[ $conclusion == success ]] || die "the release failed ($conclusion): $url"
	if [[ $dry == true ]]; then
		log "dry run done: the signed files are in the run, nothing was published: $url"
	else
		log "published: https://github.com/$repo/releases/latest"
		git -C "$ROOT/.." pull -q --ff-only origin main && log "pulled the CHANGELOG commit GitHub made"
	fi
}

cmd_shots() {
	ensure_key_and_firewall
	[[ -n $HOST ]] || HOST=$(server_ip)
	local dir
	dir="$ROOT/shots/$(date +%m%d-%H%M%S)"
	rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" "$ROOT/remote/" "root@$HOST:mast/remote/"
	log "rendering scenes on the builder"
	rssh "bash ~/mast/remote/shots.sh"
	mkdir -p "$dir"
	rsync -az --timeout=120 -e "ssh ${SSH_OPTS[*]}" --include="*.jpg" --include="*.json" --include="*.txt" --exclude="*" "root@$HOST:mast/shots/" "$dir/"
	ln -sfn "$dir" "$ROOT/shots/latest"
	log "screenshots in ${dir#"$ROOT/"}"
}

cmd_run() {
	[[ -x $ROOT/dist/mast/chrome ]] || die "no build yet. Run: ./mast build"
	local args=(--user-data-dir="$ROOT/.profile" "$@")
	if [[ -e /etc/NIXOS ]]; then
		# Chromium built on Ubuntu expects a normal Linux filesystem layout.
		# Build the runner from the system's own nixpkgs revision, so it reuses the
		# libraries already installed instead of downloading a second copy.
		local run_args=()
		if command -v nixos-version >/dev/null; then
			run_args+=(--no-write-lock-file --override-input nixpkgs "github:NixOS/nixpkgs/$(nixos-version --revision)")
		fi
		nix --extra-experimental-features 'nix-command flakes' run "${run_args[@]}" "$ROOT#fhs" -- \
			-c "$(printf '%q ' "$ROOT/dist/mast/chrome" "${args[@]}")"
	else
		"$ROOT/dist/mast/chrome" "${args[@]}"
	fi
}

# Validate make-patches.py anchors against base files rebuilt locally (tools/base-file.mjs),
# so a wrong anchor costs nothing instead of a builder session.
# Python through uv (make-patches.py needs only the standard library); nix shell would fetch
# the nixpkgs index first, and hung when channels.nixos.org timed out.
make_patches() {
	need uv
	MAST_LOCAL_BASE="$ROOT" uv run --no-project --quiet python "$ROOT/remote/make-patches.py"
}

cmd_check-patches() {
	need node
	local work
	work=$(mktemp -d)
	MAST_PATCH_WORK="$work" make_patches
	node "$ROOT/tools/rebase-check.mjs" inventory "$work"
	# The same patches on pristine Chromium, with Mast's own privacy layer (privacy.json)
	# in place of ungoogled-chromium (docs/BASE-PLAN.md): every anchor must hold there too.
	log "and on pristine Chromium (MAST_BASE=chromium)"
	MAST_BASE=chromium MAST_PATCH_WORK="$work/chromium" make_patches
	log "anchors OK; patches written to $work (pristine-Chromium ones in $work/chromium)"
}

# Before moving to another Chromium release: every patch edit, Chromium header, overridden
# method and GN dep Mast relies on (docs/UPSTREAM.md), checked against that release.
# Writes docs/rebase/<version>.md. Changes nothing else; the pinned version stays.
cmd_check-rebase() {
	need node
	local to=${1:?usage: ./mast check-rebase <chromium version> [ungoogled tag, default <version>-1]}
	local tag=${2:-$1-1} work
	work=$(mktemp -d)
	MAST_CHROMIUM_VERSION=$to MAST_UNGOOGLED_TAG=$tag node "$ROOT/tools/base-file.mjs" --series >/dev/null ||
		die "no ungoogled-chromium tag $tag (see github.com/ungoogled-software/ungoogled-chromium/tags)"
	log "patch edits on the pinned release ($(cat "$ROOT/chromium_version.txt"))"
	MAST_PATCH_WORK="$work/from" make_patches >/dev/null || die "they fail already; run ./mast check-patches"
	log "patch edits on $to"
	MAST_PATCH_WORK="$work/to" MAST_KEEP_GOING=1 MAST_CHROMIUM_VERSION=$to MAST_UNGOOGLED_TAG=$tag \
		make_patches | grep -E '^FAIL|edits fail' || true
	log "headers, overrides, GN deps, ungoogled's series"
	node "$ROOT/tools/rebase-check.mjs" report "$work" "$to" "$tag"
}

cmd=${1:-help}
shift || true
case $cmd in
	up | down | build | unattended | collect | resize | status | cost | hold | destroy | fetch | shots | release | _guard) need hcloud; need jq; "cmd_$cmd" "$@" ;;
	run) cmd_run "$@" ;;
	package) bash "$ROOT/packaging/package.sh" "$@" ;;
	publish) bash "$ROOT/packaging/publish.sh" "$@" ;;
	check-patches) cmd_check-patches "$@" ;;
	check-rebase) cmd_check-rebase "$@" ;;
	ssh) HOST=$(server_ip); ssh "${SSH_OPTS[@]}" -t "root@$HOST" "$@" ;;
	logs) HOST=$(server_ip); follow "${1:-build}" ;;
	job) HOST=$(server_ip); job "${1:?usage: ./mast job bootstrap|build}" ;;
	*) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
