# Fast, non-official release build. Official/LTO builds come later for releases.
is_debug = false
is_component_build = false
is_official_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
# AAC and H.264, like Brave, Vivaldi and Opera: Spotify streams AAC, Netflix and most MP4
# video on the web use H.264. Widevine only decrypts; the browser still decodes.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
treat_warnings_as_errors = false
# From ungoogled-chromium's flags.gn, kept on the pristine-Chromium base (docs/BASE-PLAN.md).
# Widevine is only on by default in Google Chrome builds; Mast downloads it on request.
enable_widevine = true
# Chromium's style-checking compiler plugins: never run over Mast's own code so far.
clang_use_chrome_plugins = false
exclude_unwind_tables = true
v8_drumbrake_bounds_checks = true
